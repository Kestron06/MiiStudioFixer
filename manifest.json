{
	"manifest_version": 3,
	"name": "MiiStudioFixer",
	"description": "Fix My Nintendo Mii Studio to be an actually usable Mii Editor.",
	"version": "1.0.0",
	"permissions": ["storage"],
	"icons": {
		"16": "images/icon-16.png",
		"32": "images/icon-32.png",
		"48": "images/icon-48.png",
		"96": "images/icon-96.png",
		"128": "images/icon-128.png"
	},
	"action": {
		"default_popup": "popup/popup.html",
		"default_icon": "images/icon-128.png"
	},
	"content_scripts": [
		{
			"matches": ["https://studio.mii.nintendo.com/*"],
			"js": ["content/list-store.js", "content/list-delete.js", "content/list-create.js", "content/list-restore.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://studio.mii.nintendo.com/*"],
			"js": ["content/popup-bridge.js"],
			"run_at": "document_start"
		},
		{
			"matches": ["https://studio.mii.nintendo.com/*"],
			"js": ["content/list-import.js", "content/list-export.js", "content/list.js"],
			"css": ["content/list.css", "content/list-export.css"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://studio.mii.nintendo.com/miis/*/edit*"],
			"js": ["content/hydrate.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://studio.mii.nintendo.com/miis/*/edit*"],
			"js": ["content/preview.js"],
			"css": ["content/preview.css"],
			"run_at": "document_idle"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"miijs.browser.js",
				"chunks/chunk-4EWGOUNN.js",
				"chunks/chunk-KSXM6SUT.js",
				"chunks/chunk-LAGXROHW.js",
				"chunks/chunk-MZR7SPI6.js",
				"chunks/chunk-S3A5F246.js",
				"chunks/chunk-VMLSR5BU.js",
				"chunks/chunk-WSQH7KNB.js",
				"chunks/amiiboHandler-KL7O3J65.js"
			],
			"matches": ["https://studio.mii.nintendo.com/*"]
		}
	]
}
